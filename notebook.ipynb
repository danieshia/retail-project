import pandas as pd
from sqlalchemy import create_engine

engine = create_engine('mysql+pymysql://root:Danieshia123!@localhost/giant_food_rfm')

# Pull each table and export
tables = ['monthly_revenue', 'top_products_by_quantity', 'top_products_by_revenue', 
          'uk_vs_international_revenue', 'monthly_active_customers']

for table in tables:
    df = pd.read_sql(f"SELECT * FROM {table}", engine)
    df.to_csv(f'{table}.csv', index=False)
    print(f"Exported {table}.csv")
